{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/error.schema.json",
  "title": "ProviderWire V4 bounded Gateway and direct-provider errors",
  "type": "object",
  "required": ["error"],
  "properties": { "error": { "oneOf": [ { "$ref": "#/$defs/fixedError" }, { "$ref": "#/$defs/providerError" } ] } },
  "additionalProperties": false,
  "$defs": {
    "fixedError": {
      "type": "object", "required": ["message", "type", "param", "code"],
      "properties": {
        "message": { "type": "string" }, "type": { "type": "string" }, "param": { "type": "null" }, "code": { "type": "string" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "properties": { "message": { "enum": ["invalid request", "unsupported capability: files", "unsupported capability: reasoning-content", "unsupported capability: custom-content", "unsupported capability: tools", "unsupported capability: tool-approvals", "unsupported capability: structured-output", "reserved provider option namespace", "protected call header", "protected provider option", "unsupported capability: provider-options", "unsupported capability: raw-output"] }, "type": {"const": "invalid_request_error"}, "code": {"const": "invalid_request"} } },
        { "properties": { "message": {"const": "model not found"}, "type": {"const": "model_not_found"}, "code": {"const": "model_not_found"} } },
        { "properties": { "message": {"const": "rate limit exceeded"}, "type": {"const": "rate_limit_exceeded"}, "code": {"const": "rate_limit_exceeded"} } },
        { "properties": { "message": {"const": "service overloaded"}, "type": {"const": "internal_server_error"}, "code": {"const": "overloaded"} } },
        { "properties": { "message": {"const": "failed dependency"}, "type": {"const": "failed_dependency"}, "code": {"const": "failed_dependency"} } },
        { "properties": { "message": {"const": "upstream failure"}, "type": {"const": "internal_server_error"}, "code": {"const": "upstream_error"} } },
        { "properties": { "message": {"const": "request timed out"}, "type": {"const": "internal_server_error"}, "code": {"const": "timeout"} } },
        { "properties": { "message": {"const": "request canceled"}, "type": {"const": "internal_server_error"}, "code": {"const": "canceled"} } },
        { "properties": { "message": {"const": "internal error"}, "type": {"const": "internal_server_error"}, "code": {"const": "internal_error"} } }
      ]
    },
    "providerError": {
      "type": "object", "required": ["message", "type", "param", "code"],
      "properties": {
        "message": { "type": "string", "maxLength": 4096 },
        "type": { "type": "string" },
        "code": { "type": "string" },
        "param": { "$ref": "#/$defs/providerDetail" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "properties": { "type": {"const": "invalid_request_error"}, "code": {"const": "invalid_request"} } },
        { "properties": { "type": {"const": "rate_limit_exceeded"}, "code": {"const": "rate_limit_exceeded"} } },
        { "properties": { "type": {"const": "failed_dependency"}, "code": {"const": "failed_dependency"} } },
        { "properties": { "type": {"const": "internal_server_error"}, "code": {"const": "upstream_error"} } }
      ]
    },
    "providerDetail": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 256 },
        "code": { "oneOf": [ { "type": "string", "maxLength": 256 }, { "type": "number" }, { "type": "null" } ] },
        "param": { "type": ["string", "null"], "maxLength": 4096 }
      },
      "additionalProperties": false
    }
  }
}
