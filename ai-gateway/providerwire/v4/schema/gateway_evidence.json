{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/gateway-evidence.schema.json",
  "title": "Gateway-owned providerMetadata.gateway namespace",
  "description": "Returned execution facts, not operator telemetry or replay guarantees. Native payloads remain opaque. Byte limits are enforced by the Gateway, not JSON Schema.",
  "type": "object",
  "required": [
    "routing",
    "evidence"
  ],
  "properties": {
    "routing": {
      "type": "object",
      "required": [
        "originalModelId",
        "canonicalSlug"
      ],
      "properties": {
        "originalModelId": {
          "type": "string"
        },
        "canonicalSlug": {
          "type": "string"
        },
        "finalProvider": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "requestedModelId",
        "canonicalModelId",
        "attempts"
      ],
      "properties": {
        "requestedModelId": {
          "type": "string"
        },
        "canonicalModelId": {
          "type": "string"
        },
        "selectedAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "attempts": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/attempt"
              }
            },
            {
              "type": "object",
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "const": "over-limit"
                },
                "reason": {
                  "const": "attemptCount"
                },
                "count": {
                  "type": "integer",
                  "minimum": 17
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "native": {
          "type": "object",
          "required": [
            "responseIdentity"
          ],
          "properties": {
            "responseIdentity": {
              "type": "object",
              "required": [],
              "properties": {
                "id": {
                  "type": "string"
                },
                "modelId": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "gateway": {
          "type": "object",
          "required": [
            "httpStatusCode",
            "classification",
            "phase",
            "isRetryable"
          ],
          "properties": {
            "httpStatusCode": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "classification": {
              "enum": [
                "invalid_request",
                "model_not_found",
                "rate_limit_exceeded",
                "overloaded",
                "failed_dependency",
                "upstream_error",
                "timeout",
                "canceled",
                "internal_error"
              ]
            },
            "phase": {
              "enum": [
                "unary",
                "setup",
                "committed"
              ]
            },
            "isRetryable": {
              "type": "boolean"
            },
            "replayRisk": {
              "enum": [
                "generationMayHaveRun",
                "generationCompleted"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nativeMetadata": {
      "description": "Original native gateway namespace, relocated without being treated as trusted execution evidence."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "attempt": {
      "type": "object",
      "required": [
        "index",
        "provider",
        "modelId",
        "selection"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "providerInstance": {
          "type": "string"
        },
        "selection": {
          "enum": [
            "failed",
            "selected",
            "canceled"
          ]
        },
        "completion": {
          "enum": [
            "completed",
            "incomplete"
          ]
        },
        "willFallback": {
          "type": "boolean"
        },
        "nativeError": {
          "$ref": "#/$defs/nativeError"
        }
      },
      "additionalProperties": false
    },
    "nativeError": {
      "type": "object",
      "required": [
        "isRetryable"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "code": {
          "oneOf": [
            { "type": "string" },
            { "type": "number" }
          ]
        },
        "statusCode": {
          "type": "integer",
          "minimum": 1
        },
        "isRetryable": {
          "type": "boolean"
        },
        "details": {
          "$ref": "#/$defs/component"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "available"
            },
            "value": {},
            "redacted": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "const": "producerDoesNotExpose"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "redacted"
            },
            "reason": {
              "const": "credentialSource"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "malformed"
            },
            "reason": {
              "const": "invalidJSON"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "over-limit"
            },
            "reason": {
              "enum": [
                "sourceBytes",
                "encodedBytes",
                "aggregateBytes"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
