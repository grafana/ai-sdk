{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/gateway-execution.schema.json",
  "title": "Optional Gateway execution overview namespace",
  "description": "Documentation and contract-test schema, not runtime validation or routing/replay authority. Attempt order and invocation completeness are checked by the projector. Enrichment may be omitted under existing complete-envelope limits; a native gateway namespace then remains opaque and namespace presence alone does not establish provenance.",
  "type": "object",
  "required": ["execution"],
  "properties": {
    "execution": {
      "type": "object",
      "required": ["requestedModelId", "attempts"],
      "properties": {
        "requestedModelId": { "type": "string", "minLength": 1 },
        "canonicalModelId": {
          "description": "The catalog-resolved model ID. Absent when no catalog resolution selected the model, such as with request-supplied provider credentials.",
          "type": "string",
          "minLength": 1
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attempt" }
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "description": "Optional routing summary of the execution overview, grouped by model, using a subset of the Vercel AI Gateway's documented gateway.routing fields. It describes the same attempts as execution and adds no facts.",
      "type": "object",
      "required": ["originalModelId", "resolvedProvider", "modelAttemptCount", "totalProviderAttemptCount", "modelAttempts"],
      "properties": {
        "originalModelId": { "type": "string", "minLength": 1 },
        "canonicalSlug": { "type": "string", "minLength": 1 },
        "resolvedProvider": { "type": "string", "minLength": 1 },
        "finalProvider": { "type": "string", "minLength": 1 },
        "modelAttemptCount": { "type": "integer", "minimum": 1 },
        "totalProviderAttemptCount": { "type": "integer", "minimum": 1 },
        "modelAttempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/modelAttempt" }
        }
      },
      "additionalProperties": false
    },
    "nativeMetadata": {
      "description": "The complete original native gateway value, relocated without treating its fields as Gateway execution facts."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "modelAttempt": {
      "type": "object",
      "required": ["modelId", "success", "providerAttemptCount", "providerAttempts"],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "canonicalSlug": { "type": "string", "minLength": 1 },
        "success": { "type": "boolean" },
        "providerAttemptCount": { "type": "integer", "minimum": 1 },
        "providerAttempts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/providerAttempt" }
        }
      },
      "additionalProperties": false
    },
    "providerAttempt": {
      "type": "object",
      "required": ["provider", "success"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "success": { "type": "boolean" },
        "statusCode": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["provider", "modelId", "outcome"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "providerInstance": { "type": "string" },
        "outcome": { "enum": ["failed", "selected", "canceled"] },
        "error": { "$ref": "#/$defs/failure" }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "selected" } }, "required": ["outcome"] },
          "then": { "properties": { "error": false } }
        }
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "message": { "type": "string" },
        "type": { "type": "string" },
        "code": { "oneOf": [{ "type": "string" }, { "type": "number" }] },
        "statusCode": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
