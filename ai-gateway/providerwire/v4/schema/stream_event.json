{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/stream-event.schema.json",
  "title": "ProviderWire V4 strict streaming text event",
  "oneOf": [
    { "$ref": "#/$defs/streamStart" },
    { "$ref": "#/$defs/responseMetadata" },
    { "$ref": "#/$defs/textStart" },
    { "$ref": "#/$defs/textDelta" },
    { "$ref": "#/$defs/textEnd" },
    { "$ref": "#/$defs/finish" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "streamStart": {
      "type": "object",
      "required": ["type", "warnings"],
      "properties": {
        "type": { "const": "stream-start" },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      },
      "additionalProperties": false
    },
    "responseMetadata": {
      "type": "object",
      "required": ["type", "modelId"],
      "properties": {
        "type": { "const": "response-metadata" },
        "id": { "type": "string" },
        "modelId": { "type": "string", "minLength": 1 },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      },
      "additionalProperties": false
    },
    "textStart": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "text-start" },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "textDelta": {
      "type": "object",
      "required": ["type", "id", "delta"],
      "properties": {
        "type": { "const": "text-delta" },
        "id": { "type": "string", "minLength": 1 },
        "delta": { "type": "string" }
      },
      "additionalProperties": false
    },
    "textEnd": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "text-end" },
        "id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "finish": {
      "type": "object",
      "required": ["type", "usage", "finishReason"],
      "properties": {
        "type": { "const": "finish" },
        "usage": {
          "type": "object",
          "required": ["inputTokens", "outputTokens"],
          "properties": {
            "inputTokens": { "$ref": "#/$defs/inputTokenUsage" },
            "outputTokens": { "$ref": "#/$defs/outputTokenUsage" }
          },
          "additionalProperties": false
        },
        "finishReason": { "$ref": "#/$defs/finishReason" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["type", "error"],
      "properties": {
        "type": { "const": "error" },
        "error": {
          "type": "object",
          "required": ["message", "type", "param", "code", "statusCode", "retryable"],
          "properties": {
            "message": { "enum": ["invalid request", "authentication failed", "forbidden", "model not found", "rate limit exceeded", "service overloaded", "failed dependency", "upstream failure", "request timed out", "request canceled", "internal error"] },
            "type": { "enum": ["invalid_request_error", "authentication_error", "forbidden", "model_not_found", "rate_limit_exceeded", "internal_server_error", "failed_dependency"] },
            "param": { "type": "null" },
            "code": { "enum": ["invalid_request", "authentication_error", "forbidden", "model_not_found", "rate_limit_exceeded", "overloaded", "failed_dependency", "upstream_error", "timeout", "canceled", "internal_error"] },
            "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 },
            "retryable": { "type": "boolean" }
          },
          "allOf": [
            { "if": { "properties": { "code": { "const": "invalid_request" } } }, "then": { "properties": { "message": { "const": "invalid request" }, "type": { "const": "invalid_request_error" }, "statusCode": { "const": 400 }, "retryable": { "const": false } } } },
            { "if": { "properties": { "code": { "const": "authentication_error" } } }, "then": { "properties": { "message": { "const": "authentication failed" }, "type": { "const": "authentication_error" }, "statusCode": { "const": 401 }, "retryable": { "const": false } } } },
            { "if": { "properties": { "code": { "const": "forbidden" } } }, "then": { "properties": { "message": { "const": "forbidden" }, "type": { "const": "forbidden" }, "statusCode": { "const": 403 }, "retryable": { "const": false } } } },
            { "if": { "properties": { "code": { "const": "model_not_found" } } }, "then": { "properties": { "message": { "const": "model not found" }, "type": { "const": "model_not_found" }, "statusCode": { "const": 404 }, "retryable": { "const": false } } } },
            { "if": { "properties": { "code": { "const": "rate_limit_exceeded" } } }, "then": { "properties": { "message": { "const": "rate limit exceeded" }, "type": { "const": "rate_limit_exceeded" }, "statusCode": { "const": 429 }, "retryable": { "const": true } } } },
            { "if": { "properties": { "code": { "const": "overloaded" } } }, "then": { "properties": { "message": { "const": "service overloaded" }, "type": { "const": "internal_server_error" }, "statusCode": { "const": 503 }, "retryable": { "const": true } } } },
            { "if": { "properties": { "code": { "const": "failed_dependency" } } }, "then": { "properties": { "message": { "const": "failed dependency" }, "type": { "const": "failed_dependency" }, "statusCode": { "const": 424 }, "retryable": { "const": false } } } },
            { "if": { "properties": { "code": { "const": "upstream_error" } } }, "then": { "properties": { "message": { "const": "upstream failure" }, "type": { "const": "internal_server_error" }, "statusCode": { "const": 502 }, "retryable": { "const": true } } } },
            { "if": { "properties": { "code": { "const": "timeout" } } }, "then": { "properties": { "message": { "const": "request timed out" }, "type": { "const": "internal_server_error" }, "statusCode": { "const": 504 }, "retryable": { "const": true } } } },
            { "if": { "properties": { "code": { "const": "canceled" } } }, "then": { "properties": { "message": { "const": "request canceled" }, "type": { "const": "internal_server_error" }, "statusCode": { "const": 499 }, "retryable": { "const": false } } } },
            { "if": { "properties": { "code": { "const": "internal_error" } } }, "then": { "properties": { "message": { "const": "internal error" }, "type": { "const": "internal_server_error" }, "statusCode": { "const": 500 }, "retryable": { "const": true } } } }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "finishReason": {
      "type": "object",
      "required": ["unified"],
      "properties": {
        "unified": { "enum": ["stop", "length", "content-filter", "tool-calls", "error", "other"] },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "tokenCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "inputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "noCache": { "$ref": "#/$defs/tokenCount" },
        "cacheRead": { "$ref": "#/$defs/tokenCount" },
        "cacheWrite": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "outputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "text": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "warning": {
      "oneOf": [
        { "$ref": "#/$defs/unsupportedWarning" },
        { "$ref": "#/$defs/compatibilityWarning" },
        { "$ref": "#/$defs/deprecatedWarning" },
        { "$ref": "#/$defs/otherWarning" }
      ]
    },
    "unsupportedWarning": {
      "type": "object",
      "required": ["type", "feature", "details"],
      "properties": {
        "type": { "const": "unsupported" },
        "feature": { "const": "model capability" },
        "details": { "const": "a requested model capability is unsupported" }
      },
      "additionalProperties": false
    },
    "compatibilityWarning": {
      "type": "object",
      "required": ["type", "feature", "details"],
      "properties": {
        "type": { "const": "compatibility" },
        "feature": { "const": "model compatibility" },
        "details": { "const": "a requested setting was adjusted for model compatibility" }
      },
      "additionalProperties": false
    },
    "deprecatedWarning": {
      "type": "object",
      "required": ["type", "setting", "message"],
      "properties": {
        "type": { "const": "deprecated" },
        "setting": { "const": "model setting" },
        "message": { "const": "a requested model setting is deprecated" }
      },
      "additionalProperties": false
    },
    "otherWarning": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "other" },
        "message": { "const": "the model reported a warning" }
      },
      "additionalProperties": false
    }
  }
}
