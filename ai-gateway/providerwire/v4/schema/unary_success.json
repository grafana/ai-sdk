{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/unary-success.schema.json",
  "title": "ProviderWire V4 unary text and function-call response",
  "type": "object",
  "required": ["content", "finishReason", "usage", "warnings"],
  "properties": {
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "response": { "$ref": "#/$defs/responseIdentity" },
    "providerMetadata": { "$ref": "#/$defs/providerMetadata" },
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/urlSource" },
          { "$ref": "#/$defs/documentSource" },
          { "$ref": "#/$defs/reasoning" },
          { "$ref": "#/$defs/reasoningFile" },
          {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" },
              "providerMetadata": { "$ref": "#/$defs/providerMetadata" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "toolCallId", "toolName", "input"],
            "properties": {
              "type": { "const": "tool-call" },
              "toolCallId": { "type": "string", "minLength": 1 },
              "toolName": { "type": "string", "minLength": 1 },
              "input": { "type": "string" },
              "providerMetadata": { "$ref": "#/$defs/providerMetadata" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "finishReason": {
      "type": "object",
      "required": ["unified"],
      "properties": {
        "unified": {
          "enum": ["stop", "length", "content-filter", "tool-calls", "error", "other"]
        },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/inputTokenUsage" },
        "outputTokens": { "$ref": "#/$defs/outputTokenUsage" },
        "raw": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "responseIdentity": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "modelId": { "type": "string" },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "oneOf": [
        { "type": "object", "required": ["type", "feature"], "properties": { "type": {"const": "unsupported"}, "feature": {"type": "string"}, "details": {"type": "string"} }, "additionalProperties": false },
        { "type": "object", "required": ["type", "feature"], "properties": { "type": {"const": "compatibility"}, "feature": {"type": "string"}, "details": {"type": "string"} }, "additionalProperties": false },
        { "type": "object", "required": ["type", "setting", "message"], "properties": { "type": {"const": "deprecated"}, "setting": {"type": "string"}, "message": {"type": "string"} }, "additionalProperties": false },
        { "type": "object", "required": ["type", "message"], "properties": { "type": {"const": "other"}, "message": {"type": "string"} }, "additionalProperties": false }
      ]
    },
    "reasoning": {
      "type": "object", "required": ["type", "text"],
      "properties": { "type": {"const": "reasoning"}, "text": {"type": "string"}, "providerMetadata": {"$ref": "#/$defs/providerMetadata"} },
      "additionalProperties": false
    },
    "reasoningFile": {
      "type": "object", "required": ["type", "mediaType", "data"],
      "properties": { "type": {"const": "reasoning-file"}, "mediaType": {"type": "string"}, "data": {"$ref": "#/$defs/reasoningFileData"}, "providerMetadata": {"$ref": "#/$defs/providerMetadata"} },
      "additionalProperties": false
    },
    "reasoningFileData": {
      "oneOf": [
        { "type": "object", "required": ["type", "data"], "properties": {"type": {"const": "data"}, "data": {"type": "string"}}, "additionalProperties": false },
        { "type": "object", "required": ["type", "url"], "properties": {"type": {"const": "url"}, "url": {"type": "string", "minLength": 1}}, "additionalProperties": false }
      ]
    },
    "providerMetadata": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "urlSource": {
      "type": "object",
      "required": [
        "type",
        "sourceType",
        "id",
        "url"
      ],
      "properties": {
        "type": {
          "const": "source"
        },
        "sourceType": {
          "const": "url"
        },
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "providerMetadata": {
          "$ref": "#/$defs/providerMetadata"
        }
      },
      "additionalProperties": false
    },
    "documentSource": {
      "type": "object",
      "required": [
        "type",
        "sourceType",
        "id",
        "mediaType",
        "title"
      ],
      "properties": {
        "type": {
          "const": "source"
        },
        "sourceType": {
          "const": "document"
        },
        "id": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "providerMetadata": {
          "$ref": "#/$defs/providerMetadata"
        }
      },
      "additionalProperties": false
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "noCache": { "$ref": "#/$defs/tokenCount" },
        "cacheRead": { "$ref": "#/$defs/tokenCount" },
        "cacheWrite": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "outputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "text": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    }
  }
}
