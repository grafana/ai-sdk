{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/unary-success.schema.json",
  "title": "ProviderWire V4 unary text and function tool response",
  "type": "object",
  "required": ["content", "finishReason", "usage"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/textPart" },
          { "$ref": "#/$defs/toolCallPart" }
        ]
      }
    },
    "finishReason": {
      "type": "object",
      "required": ["unified"],
      "properties": {
        "unified": {
          "enum": ["stop", "length", "content-filter", "tool-calls", "error", "other"]
        },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/inputTokenUsage" },
        "outputTokens": { "$ref": "#/$defs/outputTokenUsage" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "textPart": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "toolCallPart": {
      "type": "object",
      "required": ["type", "toolCallId", "toolName", "input"],
      "properties": {
        "type": { "const": "tool-call" },
        "toolCallId": { "type": "string", "minLength": 1 },
        "toolName": { "type": "string", "minLength": 1 },
        "input": { "type": "string" },
        "dynamic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "noCache": { "$ref": "#/$defs/tokenCount" },
        "cacheRead": { "$ref": "#/$defs/tokenCount" },
        "cacheWrite": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "outputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "text": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    }
  }
}
