{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/unary-success.schema.json",
  "title": "ProviderWire V4 unary text and function-call response",
  "type": "object",
  "required": ["content", "finishReason", "usage"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/urlSource" },
          { "$ref": "#/$defs/documentSource" },
          {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "toolCallId", "toolName", "input"],
            "properties": {
              "type": { "const": "tool-call" },
              "toolCallId": { "type": "string", "minLength": 1 },
              "toolName": { "type": "string", "minLength": 1 },
              "input": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "finishReason": {
      "type": "object",
      "required": ["unified"],
      "properties": {
        "unified": {
          "enum": ["stop", "length", "content-filter", "tool-calls", "error", "other"]
        },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/inputTokenUsage" },
        "outputTokens": { "$ref": "#/$defs/outputTokenUsage" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceMetadata": {
      "type": "object",
      "properties": {
        "citation": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "startPageNumber": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "endPageNumber": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "startCharIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "endCharIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "urlSource": {
      "type": "object",
      "required": [
        "type",
        "sourceType",
        "id",
        "url"
      ],
      "properties": {
        "type": {
          "const": "source"
        },
        "sourceType": {
          "const": "url"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "providerMetadata": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "additionalProperties": false
    },
    "documentSource": {
      "type": "object",
      "required": [
        "type",
        "sourceType",
        "id",
        "mediaType",
        "title"
      ],
      "properties": {
        "type": {
          "const": "source"
        },
        "sourceType": {
          "const": "document"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "providerMetadata": {
          "$ref": "#/$defs/sourceMetadata"
        }
      },
      "additionalProperties": false
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "noCache": { "$ref": "#/$defs/tokenCount" },
        "cacheRead": { "$ref": "#/$defs/tokenCount" },
        "cacheWrite": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "outputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "text": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    }
  }
}
