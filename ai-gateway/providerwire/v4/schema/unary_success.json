{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/unary-success.schema.json",
  "title": "ProviderWire V4 strict unary text response",
  "type": "object",
  "required": ["content", "finishReason", "usage", "warnings", "response"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "text"],
        "properties": {
          "type": { "const": "text" },
          "text": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "finishReason": {
      "type": "object",
      "required": ["unified"],
      "properties": {
        "unified": {
          "enum": ["stop", "length", "content-filter", "tool-calls", "error", "other"]
        },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/inputTokenUsage" },
        "outputTokens": { "$ref": "#/$defs/outputTokenUsage" }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "response": {
      "type": "object",
      "required": ["modelId"],
      "properties": {
        "id": { "type": "string" },
        "modelId": { "type": "string", "minLength": 1 },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "noCache": { "$ref": "#/$defs/tokenCount" },
        "cacheRead": { "$ref": "#/$defs/tokenCount" },
        "cacheWrite": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "outputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "text": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "warning": {
      "oneOf": [
        { "$ref": "#/$defs/unsupportedWarning" },
        { "$ref": "#/$defs/compatibilityWarning" },
        { "$ref": "#/$defs/deprecatedWarning" },
        { "$ref": "#/$defs/otherWarning" }
      ]
    },
    "unsupportedWarning": {
      "type": "object",
      "required": ["type", "feature"],
      "properties": {
        "type": { "const": "unsupported" },
        "feature": { "type": "string" },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    },
    "compatibilityWarning": {
      "type": "object",
      "required": ["type", "feature"],
      "properties": {
        "type": { "const": "compatibility" },
        "feature": { "type": "string" },
        "details": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deprecatedWarning": {
      "type": "object",
      "required": ["type", "setting", "message"],
      "properties": {
        "type": { "const": "deprecated" },
        "setting": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "otherWarning": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "other" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
