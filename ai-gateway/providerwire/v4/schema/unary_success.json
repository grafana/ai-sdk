{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/unary-success.schema.json",
  "title": "ProviderWire V4 unary text and function-call response",
  "type": "object",
  "required": ["content", "finishReason", "usage"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/reasoning" },
          { "$ref": "#/$defs/reasoningFile" },
          {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "toolCallId", "toolName", "input"],
            "properties": {
              "type": { "const": "tool-call" },
              "toolCallId": { "type": "string", "minLength": 1 },
              "toolName": { "type": "string", "minLength": 1 },
              "input": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "finishReason": {
      "type": "object",
      "required": ["unified"],
      "properties": {
        "unified": {
          "enum": ["stop", "length", "content-filter", "tool-calls", "error", "other"]
        },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/inputTokenUsage" },
        "outputTokens": { "$ref": "#/$defs/outputTokenUsage" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "reasoning": {
      "type": "object", "required": ["type", "text"],
      "properties": { "type": {"const": "reasoning"}, "text": {"type": "string"}, "providerMetadata": {"$ref": "#/$defs/reasoningMetadata"} },
      "additionalProperties": false
    },
    "reasoningFile": {
      "type": "object", "required": ["type", "mediaType", "data"],
      "properties": { "type": {"const": "reasoning-file"}, "mediaType": {"type": "string"}, "data": {"$ref": "#/$defs/reasoningFileData"}, "providerMetadata": {"$ref": "#/$defs/reasoningMetadata"} },
      "additionalProperties": false
    },
    "reasoningFileData": {
      "oneOf": [
        { "type": "object", "required": ["type", "data"], "properties": {"type": {"const": "data"}, "data": {"type": "string"}}, "additionalProperties": false },
        { "type": "object", "required": ["type", "url"], "properties": {"type": {"const": "url"}, "url": {"type": "string", "minLength": 1}}, "additionalProperties": false }
      ]
    },
    "reasoningMetadata": {
      "type": "object",
      "properties": {
        "anthropic": {"type": "object", "properties": {"signature": {"type": "string"}, "redactedData": {"type": "string"}}, "additionalProperties": false},
        "bedrock": {"type": "object", "properties": {"signature": {"type": "string"}, "redactedData": {"type": "string"}, "redactedContent": {"type": "string"}}, "additionalProperties": false},
        "amazonBedrock": {"type": "object", "properties": {"signature": {"type": "string"}, "redactedData": {"type": "string"}, "redactedContent": {"type": "string"}}, "additionalProperties": false},
        "openai": {"type": "object", "properties": {"itemId": {"type": "string"}, "reasoningEncryptedContent": {"type": ["string", "null"]}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "noCache": { "$ref": "#/$defs/tokenCount" },
        "cacheRead": { "$ref": "#/$defs/tokenCount" },
        "cacheWrite": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "outputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "text": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    }
  }
}
