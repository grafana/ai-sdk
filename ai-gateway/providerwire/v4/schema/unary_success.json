{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/unary-success.schema.json",
  "title": "ProviderWire V4 unary text and function-call response",
  "type": "object",
  "required": ["content", "finishReason", "usage"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" },
              "providerMetadata": { "$ref": "#/$defs/textProviderMetadata" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "toolCallId", "toolName", "input"],
            "properties": {
              "type": { "const": "tool-call" },
              "toolCallId": { "type": "string", "minLength": 1 },
              "toolName": { "type": "string", "minLength": 1 },
              "input": { "type": "string" },
              "providerMetadata": { "$ref": "#/$defs/toolProviderMetadata" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "finishReason": {
      "type": "object",
      "required": ["unified"],
      "properties": {
        "unified": {
          "enum": ["stop", "length", "content-filter", "tool-calls", "error", "other"]
        },
        "raw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["inputTokens", "outputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/inputTokenUsage" },
        "outputTokens": { "$ref": "#/$defs/outputTokenUsage" },
        "raw": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "itemId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "openaiMetadata": {
      "type": "object", "required": ["itemId"],
      "properties": { "itemId": { "$ref": "#/$defs/itemId" } },
      "additionalProperties": false
    },
    "anthropicMetadata": {
      "type": "object", "required": ["caller"],
      "properties": { "caller": { "type": "object", "required": ["type"], "properties": { "type": { "const": "direct" } }, "additionalProperties": false } },
      "additionalProperties": false
    },
    "textProviderMetadata": {
      "type": "object", "required": ["openai"],
      "properties": { "openai": { "$ref": "#/$defs/openaiMetadata" } },
      "additionalProperties": false
    },
    "toolProviderMetadata": {
      "type": "object", "minProperties": 1,
      "properties": { "openai": { "$ref": "#/$defs/openaiMetadata" }, "anthropic": { "$ref": "#/$defs/anthropicMetadata" } },
      "additionalProperties": false
    },
    "tokenCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "noCache": { "$ref": "#/$defs/tokenCount" },
        "cacheRead": { "$ref": "#/$defs/tokenCount" },
        "cacheWrite": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    },
    "outputTokenUsage": {
      "type": "object",
      "properties": {
        "total": { "$ref": "#/$defs/tokenCount" },
        "text": { "$ref": "#/$defs/tokenCount" },
        "reasoning": { "$ref": "#/$defs/tokenCount" }
      },
      "additionalProperties": false
    }
  }
}
