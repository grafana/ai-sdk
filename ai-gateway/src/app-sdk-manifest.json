{
    "apiVersion": "apps.grafana.app/v1alpha2",
    "kind": "AppManifest",
    "metadata": {
        "name": "aigateway"
    },
    "spec": {
        "appName": "aigateway",
        "appDisplayName": "AI Gateway",
        "group": "aigateway.ext.grafana.app",
        "versions": [
            {
                "name": "v1alpha1",
                "served": true,
                "kinds": [
                    {
                        "kind": "StoredChatCompletion",
                        "plural": "StoredChatCompletions",
                        "scope": "Namespaced",
                        "userReadable": false,
                        "schemas": {
                            "StoredChatCompletion": {
                                "properties": {
                                    "spec": {
                                        "$ref": "#/components/schemas/spec"
                                    }
                                },
                                "required": [
                                    "spec"
                                ]
                            },
                            "spec": {
                                "additionalProperties": false,
                                "properties": {
                                    "created": {
                                        "type": "integer"
                                    },
                                    "expiresAt": {
                                        "type": "integer"
                                    },
                                    "id": {
                                        "type": "string"
                                    },
                                    "model": {
                                        "type": "string"
                                    },
                                    "owner": {
                                        "type": "string"
                                    },
                                    "record": {
                                        "description": "JSON contains the sanitized public record, never provider credentials.",
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "owner",
                                    "id",
                                    "created",
                                    "expiresAt",
                                    "model",
                                    "record"
                                ],
                                "type": "object"
                            }
                        },
                        "conversion": false
                    }
                ],
                "routes": {
                    "namespaced": {
                        "/config": {
                            "get": {
                                "operationId": "getConfig",
                                "parameters": [
                                    {
                                        "name": "namespace",
                                        "in": "path",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire discovery response"
                                    }
                                }
                            }
                        },
                        "/language-model": {
                            "post": {
                                "operationId": "createLanguageModel",
                                "parameters": [
                                    {
                                        "name": "namespace",
                                        "in": "path",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire language-model response"
                                    }
                                }
                            }
                        },
                        "/v1/chat/completions": {
                            "post": {
                                "operationId": "createChatCompletion",
                                "parameters": [
                                    {
                                        "name": "namespace",
                                        "in": "path",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "OpenAI Chat Completions response"
                                    }
                                }
                            }
                        }
                    }
                },
                "openapi": {
                    "paths": {
                        "/namespaces/{namespace}/config": {
                            "get": {
                                "operationId": "getConfig",
                                "parameters": [
                                    {
                                        "in": "path",
                                        "name": "namespace",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire discovery response"
                                    }
                                }
                            },
                            "parameters": [
                                {
                                    "in": "path",
                                    "name": "namespace",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ]
                        },
                        "/namespaces/{namespace}/language-model": {
                            "parameters": [
                                {
                                    "in": "path",
                                    "name": "namespace",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "post": {
                                "operationId": "createLanguageModel",
                                "parameters": [
                                    {
                                        "in": "path",
                                        "name": "namespace",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire language-model response"
                                    }
                                }
                            }
                        },
                        "/namespaces/{namespace}/v1/chat/completions": {
                            "parameters": [
                                {
                                    "in": "path",
                                    "name": "namespace",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "post": {
                                "operationId": "createChatCompletion",
                                "parameters": [
                                    {
                                        "in": "path",
                                        "name": "namespace",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "OpenAI Chat Completions response"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ],
        "preferredVersion": "v1alpha1",
        "roles": {
            "aigateway:client": {
                "title": "AI Gateway Client",
                "description": "Use authenticated Gateway protocol routes",
                "routes": [
                    "getConfig",
                    "createLanguageModel",
                    "createChatCompletion"
                ]
            }
        },
        "roleBindings": {
            "viewer": [
                "aigateway:client"
            ],
            "editor": [
                "aigateway:client"
            ],
            "admin": [
                "aigateway:client"
            ]
        }
    }
}