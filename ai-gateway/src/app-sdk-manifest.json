{
    "apiVersion": "apps.grafana.app/v1alpha2",
    "kind": "AppManifest",
    "metadata": {
        "name": "aigateway"
    },
    "spec": {
        "appName": "aigateway",
        "appDisplayName": "AI Gateway",
        "group": "aigateway.ext.grafana.app",
        "versions": [
            {
                "name": "v1alpha1",
                "served": true,
                "kinds": [
                    {
                        "kind": "ModelCatalog",
                        "plural": "ModelCatalogs",
                        "scope": "Namespaced",
                        "userReadable": false,
                        "folderScoped": false,
                        "admission": {
                            "validation": {
                                "operations": [
                                    "CREATE",
                                    "UPDATE"
                                ]
                            }
                        },
                        "schemas": {
                            "Model": {
                                "additionalProperties": false,
                                "properties": {
                                    "aliases": {
                                        "items": {
                                            "type": "string"
                                        },
                                        "type": "array"
                                    },
                                    "description": {
                                        "type": "string"
                                    },
                                    "fallback": {
                                        "items": {
                                            "$ref": "#/components/schemas/Target"
                                        },
                                        "type": "array"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "primary": {
                                        "$ref": "#/components/schemas/Target"
                                    }
                                },
                                "required": [
                                    "name",
                                    "primary"
                                ],
                                "type": "object"
                            },
                            "ModelCatalog": {
                                "properties": {
                                    "secure": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "description": "Provider API key, keyed by the provider name",
                                            "allOf": [
                                                {
                                                    "$ref": "#/components/schemas/com.github.grafana.grafana-app-sdk.resource.InlineSecureValue"
                                                }
                                            ]
                                        }
                                    },
                                    "spec": {
                                        "$ref": "#/components/schemas/spec"
                                    }
                                },
                                "required": [
                                    "spec"
                                ]
                            },
                            "Provider": {
                                "additionalProperties": false,
                                "properties": {
                                    "baseURL": {
                                        "type": "string"
                                    },
                                    "providerName": {
                                        "type": "string"
                                    },
                                    "supportsStructuredOutputs": {
                                        "type": "boolean"
                                    },
                                    "type": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "type"
                                ],
                                "type": "object"
                            },
                            "Target": {
                                "additionalProperties": false,
                                "properties": {
                                    "model": {
                                        "type": "string"
                                    },
                                    "provider": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "provider",
                                    "model"
                                ],
                                "type": "object"
                            },
                            "com.github.grafana.grafana-app-sdk.resource.InlineSecureValue": {
                                "type": "object",
                                "oneOf": [
                                    {
                                        "required": [
                                            "create"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "name"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "remove"
                                        ]
                                    }
                                ],
                                "not": {
                                    "required": [
                                        "description"
                                    ],
                                    "not": {
                                        "required": [
                                            "create"
                                        ]
                                    }
                                },
                                "properties": {
                                    "create": {
                                        "description": "Plaintext value to create in the secret service. Used only in create or update requests.",
                                        "type": "string",
                                        "maxLength": 24576,
                                        "minLength": 1
                                    },
                                    "description": {
                                        "description": "Optional description for a newly created secret. Only valid when create is set.",
                                        "type": "string"
                                    },
                                    "name": {
                                        "description": "Reference to an existing value in the secret service.",
                                        "type": "string",
                                        "maxLength": 253,
                                        "minLength": 1
                                    },
                                    "remove": {
                                        "description": "Remove this entry from the secure value map, deleting the secret if it is owned by this resource.",
                                        "type": "boolean"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "spec": {
                                "additionalProperties": false,
                                "properties": {
                                    "models": {
                                        "additionalProperties": {
                                            "$ref": "#/components/schemas/Model"
                                        },
                                        "type": "object"
                                    },
                                    "providers": {
                                        "additionalProperties": {
                                            "$ref": "#/components/schemas/Provider"
                                        },
                                        "type": "object"
                                    }
                                },
                                "required": [
                                    "providers",
                                    "models"
                                ],
                                "type": "object"
                            }
                        },
                        "secure": [
                            {
                                "key": "*",
                                "description": "Provider API key, keyed by the provider name"
                            }
                        ],
                        "conversion": false
                    },
                    {
                        "kind": "Middleware",
                        "plural": "Middlewares",
                        "scope": "Namespaced",
                        "userReadable": false,
                        "folderScoped": false,
                        "admission": {
                            "validation": {
                                "operations": [
                                    "CREATE",
                                    "UPDATE"
                                ]
                            }
                        },
                        "schemas": {
                            "Middleware": {
                                "properties": {
                                    "spec": {
                                        "$ref": "#/components/schemas/spec"
                                    }
                                },
                                "required": [
                                    "spec"
                                ]
                            },
                            "spec": {
                                "additionalProperties": false,
                                "properties": {
                                    "defaultInstructions": {
                                        "additionalProperties": false,
                                        "description": "Default system messages for calls that have none.",
                                        "properties": {
                                            "messages": {
                                                "description": "System messages prepended, in order, to calls whose prompt has no system message.",
                                                "items": {
                                                    "additionalProperties": false,
                                                    "properties": {
                                                        "content": {
                                                            "description": "The system message text.",
                                                            "type": "string"
                                                        }
                                                    },
                                                    "required": [
                                                        "content"
                                                    ],
                                                    "type": "object"
                                                },
                                                "type": "array"
                                            }
                                        },
                                        "required": [
                                            "messages"
                                        ],
                                        "type": "object"
                                    },
                                    "defaultSettings": {
                                        "additionalProperties": false,
                                        "description": "Default sampling and limit settings for calls that leave them unset.",
                                        "properties": {
                                            "frequencyPenalty": {
                                                "description": "The frequency penalty.",
                                                "type": "number"
                                            },
                                            "maxOutputTokens": {
                                                "description": "The maximum number of tokens to generate.",
                                                "type": "integer"
                                            },
                                            "presencePenalty": {
                                                "description": "The presence penalty.",
                                                "type": "number"
                                            },
                                            "seed": {
                                                "description": "The seed for deterministic sampling, where the model supports it.",
                                                "type": "integer"
                                            },
                                            "stopSequences": {
                                                "description": "Sequences that stop generation.",
                                                "items": {
                                                    "type": "string"
                                                },
                                                "type": "array"
                                            },
                                            "temperature": {
                                                "description": "The sampling temperature.",
                                                "type": "number"
                                            },
                                            "topK": {
                                                "description": "The number of most likely tokens to sample from.",
                                                "type": "integer"
                                            },
                                            "topP": {
                                                "description": "The nucleus sampling probability mass.",
                                                "type": "number"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "type": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "type",
                                    "enabled"
                                ],
                                "type": "object"
                            }
                        },
                        "conversion": false
                    }
                ],
                "routes": {
                    "namespaced": {
                        "/config": {
                            "get": {
                                "operationId": "getConfig",
                                "parameters": [
                                    {
                                        "name": "namespace",
                                        "in": "path",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire discovery response"
                                    }
                                }
                            }
                        },
                        "/language-model": {
                            "post": {
                                "operationId": "createLanguageModel",
                                "parameters": [
                                    {
                                        "name": "namespace",
                                        "in": "path",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire language-model response"
                                    }
                                }
                            }
                        }
                    }
                },
                "openapi": {
                    "paths": {
                        "/namespaces/{namespace}/config": {
                            "get": {
                                "operationId": "getConfig",
                                "parameters": [
                                    {
                                        "in": "path",
                                        "name": "namespace",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire discovery response"
                                    }
                                }
                            },
                            "parameters": [
                                {
                                    "in": "path",
                                    "name": "namespace",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ]
                        },
                        "/namespaces/{namespace}/language-model": {
                            "parameters": [
                                {
                                    "in": "path",
                                    "name": "namespace",
                                    "required": true,
                                    "schema": {
                                        "type": "string"
                                    }
                                }
                            ],
                            "post": {
                                "operationId": "createLanguageModel",
                                "parameters": [
                                    {
                                        "in": "path",
                                        "name": "namespace",
                                        "required": true,
                                        "schema": {
                                            "type": "string"
                                        }
                                    }
                                ],
                                "responses": {
                                    "default": {
                                        "description": "ProviderWire language-model response"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        ],
        "preferredVersion": "v1alpha1",
        "roles": {
            "aigateway:catalogreader": {
                "title": "Model catalog reader",
                "description": "Read AI Gateway model catalogs",
                "kinds": [
                    {
                        "kind": "ModelCatalog",
                        "permissionSet": "viewer"
                    }
                ]
            },
            "aigateway:catalogwriter": {
                "title": "Model catalog writer",
                "description": "Create, update and delete AI Gateway model catalogs",
                "kinds": [
                    {
                        "kind": "ModelCatalog",
                        "permissionSet": "editor"
                    }
                ]
            },
            "aigateway:middlewarereader": {
                "title": "Middleware reader",
                "description": "Read AI Gateway tenant extension configuration",
                "kinds": [
                    {
                        "kind": "Middleware",
                        "permissionSet": "viewer"
                    }
                ]
            },
            "aigateway:middlewarewriter": {
                "title": "Middleware writer",
                "description": "Create, update and delete AI Gateway tenant extension configuration",
                "kinds": [
                    {
                        "kind": "Middleware",
                        "permissionSet": "editor"
                    }
                ]
            }
        },
        "roleBindings": {
            "viewer": [
                "aigateway:catalogreader",
                "aigateway:middlewarereader"
            ],
            "admin": [
                "aigateway:catalogwriter",
                "aigateway:middlewarewriter"
            ]
        }
    }
}