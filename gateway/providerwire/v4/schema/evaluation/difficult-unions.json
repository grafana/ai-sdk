{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/evaluation/difficult-unions.json",
  "title": "GeneratorDifficultUnionCorpus",
  "type": "object",
  "properties": {
    "message": { "$ref": "#/$defs/message" },
    "tool": { "$ref": "#/$defs/tool" },
    "file": { "$ref": "#/$defs/file" },
    "optionalFalse": { "type": "boolean" },
    "explicitEmpty": { "type": "array", "items": { "type": "string" } },
    "nullableOpaque": {},
    "nonNullOpaque": { "not": { "type": "null" } },
    "keyedObjects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "required": ["message", "tool", "file", "nullableOpaque", "nonNullOpaque", "keyedObjects"],
  "additionalProperties": false,
  "$defs": {
    "message": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "role": { "const": "system" },
            "content": { "type": "string" }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": { "const": "user" },
            "content": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        }
      ]
    },
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "function" },
            "name": { "type": "string" },
            "strict": { "type": "boolean" }
          },
          "required": ["type", "name"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "provider" },
            "id": { "type": "string" },
            "args": { "type": "object", "additionalProperties": true }
          },
          "required": ["type", "id", "args"],
          "additionalProperties": false
        }
      ]
    },
    "file": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "data" },
            "data": { "type": "string" }
          },
          "required": ["type", "data"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "url" },
            "url": { "type": "string" }
          },
          "required": ["type", "url"],
          "additionalProperties": false
        }
      ]
    }
  }
}
