{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafana.com/ai-sdk/providerwire/v4/schema/request.json",
  "title": "ProviderWire V4 post-Gateway request",
  "type": "object",
  "properties": {
    "prompt": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    },
    "maxOutputTokens": { "type": "number" },
    "temperature": { "type": "number" },
    "stopSequences": { "type": "array", "items": { "type": "string" } },
    "topP": { "type": "number" },
    "topK": { "type": "number" },
    "presencePenalty": { "type": "number" },
    "frequencyPenalty": { "type": "number" },
    "responseFormat": { "$ref": "#/$defs/responseFormat" },
    "seed": { "type": "number" },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "toolChoice": { "$ref": "#/$defs/toolChoice" },
    "includeRawChunks": { "type": "boolean" },
    "headers": { "$ref": "common.json#/$defs/headers" },
    "reasoning": {
      "enum": ["provider-default", "none", "minimal", "low", "medium", "high", "xhigh"]
    },
    "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
  },
  "required": ["prompt"],
  "additionalProperties": false,
  "$defs": {
    "message": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "role": { "const": "system" },
            "content": { "type": "string" },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": { "const": "user" },
            "content": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/textPart" },
                  { "$ref": "#/$defs/filePart" }
                ]
              }
            },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": { "const": "assistant" },
            "content": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/textPart" },
                  { "$ref": "#/$defs/filePart" },
                  { "$ref": "#/$defs/customPart" },
                  { "$ref": "#/$defs/reasoningPart" },
                  { "$ref": "#/$defs/reasoningFilePart" },
                  { "$ref": "#/$defs/toolCallPart" },
                  { "$ref": "#/$defs/toolResultPart" }
                ]
              }
            },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": { "const": "tool" },
            "content": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/toolResultPart" },
                  { "$ref": "#/$defs/toolApprovalResponsePart" }
                ]
              }
            },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["role", "content"],
          "additionalProperties": false
        }
      ]
    },
    "textPart": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "reasoningPart": {
      "type": "object",
      "properties": {
        "type": { "const": "reasoning" },
        "text": { "type": "string" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "customPart": {
      "type": "object",
      "properties": {
        "type": { "const": "custom" },
        "kind": { "type": "string", "pattern": "\\." },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "kind"],
      "additionalProperties": false
    },
    "filePart": {
      "type": "object",
      "properties": {
        "type": { "const": "file" },
        "filename": { "type": "string" },
        "data": { "$ref": "common.json#/$defs/fileData" },
        "mediaType": { "type": "string" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "data", "mediaType"],
      "additionalProperties": false
    },
    "reasoningFilePart": {
      "type": "object",
      "properties": {
        "type": { "const": "reasoning-file" },
        "data": { "$ref": "common.json#/$defs/generatedFileData" },
        "mediaType": { "type": "string" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "data", "mediaType"],
      "additionalProperties": false
    },
    "toolCallPart": {
      "type": "object",
      "properties": {
        "type": { "const": "tool-call" },
        "toolCallId": { "type": "string" },
        "toolName": { "type": "string" },
        "input": { "$ref": "common.json#/$defs/jsonValue" },
        "providerExecuted": { "type": "boolean" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "toolCallId", "toolName", "input"],
      "additionalProperties": false
    },
    "toolResultPart": {
      "type": "object",
      "properties": {
        "type": { "const": "tool-result" },
        "toolCallId": { "type": "string" },
        "toolName": { "type": "string" },
        "output": { "$ref": "#/$defs/toolResultOutput" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "toolCallId", "toolName", "output"],
      "additionalProperties": false
    },
    "toolApprovalResponsePart": {
      "type": "object",
      "properties": {
        "type": { "const": "tool-approval-response" },
        "approvalId": { "type": "string" },
        "approved": { "type": "boolean" },
        "reason": { "type": "string" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "approvalId", "approved"],
      "additionalProperties": false
    },
    "toolResultOutput": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "text" },
            "value": { "type": "string" },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "json" },
            "value": { "$ref": "common.json#/$defs/jsonValue" },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "execution-denied" },
            "reason": { "type": "string" },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "error-text" },
            "value": { "type": "string" },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "error-json" },
            "value": { "$ref": "common.json#/$defs/jsonValue" },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "content" },
            "value": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "$ref": "#/$defs/toolResultTextContent" },
                  { "$ref": "#/$defs/toolResultFileContent" },
                  { "$ref": "#/$defs/toolResultCustomContent" }
                ]
              }
            }
          },
          "required": ["type", "value"],
          "additionalProperties": false
        }
      ]
    },
    "toolResultTextContent": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "text"],
      "additionalProperties": false
    },
    "toolResultFileContent": {
      "type": "object",
      "properties": {
        "type": { "const": "file" },
        "data": { "$ref": "common.json#/$defs/fileData" },
        "mediaType": { "type": "string" },
        "filename": { "type": "string" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type", "data", "mediaType"],
      "additionalProperties": false
    },
    "toolResultCustomContent": {
      "type": "object",
      "properties": {
        "type": { "const": "custom" },
        "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "responseFormat": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "const": "text" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "json" },
            "schema": { "$ref": "common.json#/$defs/jsonSchemaObject" },
            "name": { "type": "string" },
            "description": { "type": "string" }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    },
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "function" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "inputSchema": { "$ref": "common.json#/$defs/jsonSchemaObject" },
            "inputExamples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "input": { "$ref": "common.json#/$defs/jsonObject" }
                },
                "required": ["input"],
                "additionalProperties": false
              }
            },
            "strict": { "type": "boolean" },
            "providerOptions": { "$ref": "common.json#/$defs/providerOptions" }
          },
          "required": ["type", "name", "inputSchema"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "provider" },
            "id": { "type": "string", "pattern": "\\." },
            "name": { "type": "string" },
            "args": { "$ref": "common.json#/$defs/jsonObject" }
          },
          "required": ["type", "id", "name", "args"],
          "additionalProperties": false
        }
      ]
    },
    "toolChoice": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "type": { "const": "auto" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "none" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "type": { "const": "required" } },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "tool" },
            "toolName": { "type": "string" }
          },
          "required": ["type", "toolName"],
          "additionalProperties": false
        }
      ]
    }
  }
}
