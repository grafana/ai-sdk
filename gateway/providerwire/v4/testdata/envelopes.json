{
  "seeds": [
    {
      "name": "unary",
      "document": {
        "method": "POST",
        "path": "/language-model",
        "headers": {
          "ai-language-model-id": "model.v4",
          "ai-language-model-specification-version": "4",
          "ai-language-model-streaming": "false",
          "content-type": "application/json"
        }
      }
    },
    {
      "name": "stream",
      "document": {
        "method": "POST",
        "path": "/language-model",
        "headers": {
          "Ai-Language-Model-Id": "model.v4",
          "AI-Language-Model-Specification-Version": "4",
          "ai-language-model-streaming": "true",
          "Content-Type": "application/json; charset=utf-8",
          "Accept": "text/event-stream"
        }
      }
    }
  ],
  "cases": [
    { "name": "unary exact", "base": "unary", "wantMediaType": "application/json" },
    { "name": "stream exact", "base": "stream", "wantMediaType": "text/event-stream" },
    {
      "name": "unary omitted accept",
      "base": "unary",
      "wantMediaType": "application/json",
      "mutations": [
        { "operation": "set", "path": "/headers/ai-language-model-id", "value": "model v4" },
        { "operation": "set", "path": "/headers/content-type", "value": "application/json; profile=contract" }
      ]
    },
    {
      "name": "present empty accept",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "" }]
    },
    {
      "name": "unary type wildcard",
      "base": "unary",
      "wantMediaType": "application/json",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "text/plain;q=0.8, application/*;q=0.5" }]
    },
    {
      "name": "wrong method",
      "base": "unary",
      "wantCategory": "method",
      "mutations": [{ "operation": "set", "path": "/method", "value": "GET" }]
    },
    {
      "name": "wrong path",
      "base": "unary",
      "wantCategory": "path",
      "mutations": [{ "operation": "set", "path": "/path", "value": "/v4/language-model" }]
    },
    {
      "name": "missing model id",
      "base": "unary",
      "wantCategory": "model-id",
      "mutations": [{ "operation": "remove", "path": "/headers/ai-language-model-id" }]
    },
    {
      "name": "padded model id",
      "base": "unary",
      "wantCategory": "model-id",
      "mutations": [{ "operation": "set", "path": "/headers/ai-language-model-id", "value": " model.v4 " }]
    },
    {
      "name": "wrong version",
      "base": "unary",
      "wantCategory": "specification-version",
      "mutations": [{ "operation": "set", "path": "/headers/ai-language-model-specification-version", "value": "v4" }]
    },
    {
      "name": "uppercase streaming",
      "base": "unary",
      "wantCategory": "streaming",
      "mutations": [{ "operation": "set", "path": "/headers/ai-language-model-streaming", "value": "TRUE" }]
    },
    {
      "name": "missing content type",
      "base": "unary",
      "wantCategory": "content-type",
      "mutations": [{ "operation": "remove", "path": "/headers/content-type" }]
    },
    {
      "name": "wrong content type",
      "base": "unary",
      "wantCategory": "content-type",
      "mutations": [{ "operation": "set", "path": "/headers/content-type", "value": "text/plain" }]
    },
    {
      "name": "incompatible accept",
      "base": "stream",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/Accept", "value": "application/json" }]
    },
    {
      "name": "quality zero",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q=0" }]
    },
    {
      "name": "stock client full wildcard",
      "base": "unary",
      "wantMediaType": "application/json",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "*/*" }]
    },
    {
      "name": "empty accept member",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json," }]
    },
    {
      "name": "minimum positive quality",
      "base": "unary",
      "wantMediaType": "application/json",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q=0.001" }]
    },
    {
      "name": "quoted quality is invalid",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q=\"0.5\"" }]
    },
    {
      "name": "whitespace around quality equals is invalid",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q = 0.5" }]
    },
    {
      "name": "scientific quality is invalid",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q=1e-1" }]
    },
    {
      "name": "quality precision over three digits is invalid",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q=0.0001" }]
    },
    {
      "name": "quality above one is invalid",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q=1.001" }]
    },
    {
      "name": "malformed accept quality",
      "base": "unary",
      "wantCategory": "accept",
      "mutations": [{ "operation": "set", "path": "/headers/accept", "value": "application/json;q=wat" }]
    }
  ]
}
