{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "bootstrap-sha": "1ac1e919b81c0b868c1361c253378ae02201d0ef",
  "last-release-sha": "1ac1e919b81c0b868c1361c253378ae02201d0ef",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "/",
  "versioning": "prerelease",
  "prerelease": true,
  "bump-minor-pre-major": true,
  "separate-pull-requests": true,
  "pull-request-header": "Merging this pull request tags this module and publishes its GitHub Release. Release every first-party prerequisite before a module that depends on it; see release/README.md for the dependency order.",
  "pull-request-footer": "Versions and changelog entries are derived from Conventional Commits. See [release/README.md](https://github.com/grafana/ai-sdk/blob/main/release/README.md).",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true }
  ],
  "packages": {
    ".": {
