  {
    "name": "mcp-result-in-tool-message",
    "description": "SYNTHETIC: a tool-message result matching a hosted-MCP tool use stays a tool_result.",
    "prompt": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What is the weather?"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "tool-call",
            "toolCallId": "mcp-1",
            "toolName": "search_docs",
            "input": {
              "query": "cache"
            },
            "providerExecuted": true,
            "providerOptions": {
              "anthropic": {
                "type": "mcp-tool-use",
                "serverName": "docs"
              }
            }
          }
        ]
      },
      {
        "role": "tool",
        "content": [
          {
            "type": "tool-result",
            "toolCallId": "mcp-1",
            "toolName": "search_docs",
            "output": {
              "type": "json",
              "value": "found 2 pages"
            }
          }
        ]
      }
    ]
  },
