{
  "name": "@ai-sdk/conformance-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate-baseline": "tsx validate-baseline.mts",
    "upgrade-baseline": "node upgrade-baseline.mjs",
    "coverage-inventory": "tsx coverage-inventory.mts",
    "provider-shape": "tsx provider-shape.mts",
    "test:baseline": "tsx --test validate-baseline.test.mts upgrade-baseline.test.mjs upgrade-target.test.mjs bedrock-schema-generation.test.mjs common.test.mts fixture-inventory.test.mts record.test.mts",
    "test:ci": "tsx --test ci-workflow.test.mts",
    "generate": "tsx generate.mts",
    "record": "tsx record.mts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.125",
    "@ai-sdk/anthropic": "4.0.89",
    "@ai-sdk/openai": "4.0.103",
    "@ai-sdk/openai-compatible": "3.0.79",
    "@ai-sdk/provider": "4.0.34",
    "@ai-sdk/provider-utils": "5.0.69",
    "ai": "7.0.154",
    "yaml": "^2.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
