{
  "name": "@ai-sdk/conformance-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate-baseline": "tsx validate-baseline.mts",
    "upgrade-baseline": "node upgrade-baseline.mjs",
    "coverage-inventory": "tsx coverage-inventory.mts",
    "provider-shape": "tsx provider-shape.mts",
    "test:baseline": "tsx --test validate-baseline.test.mts upgrade-baseline.test.mjs upgrade-target.test.mjs bedrock-schema-generation.test.mjs common.test.mts fixture-inventory.test.mts provider-shape.test.mts record.test.mts",
    "test:ci": "tsx --test ci-workflow.test.mts",
    "generate": "tsx generate.mts",
    "record": "tsx record.mts"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.146",
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@ai-sdk/provider": "4.0.39",
    "@ai-sdk/provider-utils": "5.0.83",
    "ai": "7.0.179",
    "yaml": "^2.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/parser": "8.1.3",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
